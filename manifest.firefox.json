{
  "manifest_version": 3,
  "name": "0flufStart",
  "version": "5.5.0",
  "description": "Zero-Fluff. All Speed. A privacy-first, minimalist start page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "0fluffstart-v2@extension.local",
      "strict_min_version": "109.0"
    }
  },
  "optional_host_permissions": [
    "https://0fluffstart-suggest-proxy.jbuilds.workers.dev/*",
    "https://api.allorigins.win/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png",
    "192": "icon.png",
    "512": "icon.png"
  }
}

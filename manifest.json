{
  "manifest_version": 3,
  "name": "0FluffStart",
  "version": "6.3.0",
  "description": "Zero-Fluff. All Speed. A privacy-first, minimalist start page.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "search"
  ],
  "host_permissions": [
    "https://0fluffstart-suggest-proxy.jbuilds.workers.dev/*"
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png",
    "192": "icon.png",
    "512": "icon.png"
  }
}
